# Cadena de conexión a PostgreSQL.
# Local:  postgresql://usuario:clave@localhost:5432/synapbase
# Neon:   postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/synapbase?sslmode=require
DATABASE_URL=

# Opcional: tamaño máximo del pool de conexiones (por defecto 5).
# En Vercel conviene dejarlo bajo y usar el endpoint "-pooler" de Neon.
# PGPOOL_MAX=5

# ————— Avisos por mail —————
# Cuando alguien crea una cuenta o termina de dar de alta su comercio, llega un
# mail a NOTIFY_EMAIL_TO. Si falta cualquiera de las dos variables, el aviso se
# escribe en el log y el registro sigue funcionando igual.
#
# La clave se saca en https://resend.com (plan gratuito: 3.000 mails por mes).
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL_TO=juansarricouet@gmail.com
#
# Remitente. Resend pide un dominio verificado; onboarding@resend.dev sirve para
# probar, pero sólo entrega a la casilla dueña de la cuenta de Resend.
# NOTIFY_EMAIL_FROM=SynapBase <avisos@tudominio.com>

# ————— Panel de administración —————
# Emails que pueden entrar a /admin, separados por coma. Con la lista vacía no
# entra nadie: si falta la variable, el panel queda cerrado y no abierto.
# ADMIN_EMAILS=juansarricouet@gmail.com

# ————— Cobro —————
# El cobro es manual: el comercio paga por fuera, avisa desde su panel, llega
# un mail a NOTIFY_EMAIL_TO y se confirma desde /admin. Alcanza con configurar
# el alias; el link es opcional.
# PAYMENT_ALIAS=tu.alias.mp
# PAYMENT_HOLDER=Juan A. Sarricouet
# Un solo link para todos los planes (lo habitual con una cuenta personal):
# PAYMENT_LINK=https://link.mercadopago.com.ar/synapbase
# O uno por plan, si preferís montos separados:
# PAYMENT_LINK_PRO=https://mpago.la/xxxxxx
# PAYMENT_LINK_BUSINESS=https://mpago.la/yyyyyy

# Clave con la que Vercel firma las llamadas del cron diario de vencimientos.
# La inventás vos y la cargás acá; Vercel la manda sola en cada llamada. Si
# falta, la tarea sigue andando pero cualquiera puede dispararla desde afuera.
# CRON_SECRET=
