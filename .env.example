# Cadena de conexión a PostgreSQL.
# Local:  postgresql://usuario:clave@localhost:5432/synapbase
# Neon:   postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/synapbase?sslmode=require
DATABASE_URL=

# Opcional: tamaño máximo del pool de conexiones (por defecto 5).
# En Vercel conviene dejarlo bajo y usar el endpoint "-pooler" de Neon.
# PGPOOL_MAX=5

# ————— Avisos por mail —————
# Cuando alguien crea una cuenta o termina de dar de alta su comercio, llega un
# mail a NOTIFY_EMAIL_TO. Si falta cualquiera de las dos variables, el aviso se
# escribe en el log y el registro sigue funcionando igual.
#
# La clave se saca en https://resend.com (plan gratuito: 3.000 mails por mes).
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL_TO=juansarricouet@gmail.com
#
# Remitente. Resend pide un dominio verificado; onboarding@resend.dev sirve para
# probar, pero sólo entrega a la casilla dueña de la cuenta de Resend.
# NOTIFY_EMAIL_FROM=SynapBase <avisos@tudominio.com>
